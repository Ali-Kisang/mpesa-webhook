# ---- Required ----------------------------------------------------------------------
# Secret part of the callback URL you give Safaricom: https://YOUR_DOMAIN/mpesa/callback/<this>
# Generate one with:  openssl rand -hex 24
CALLBACK_SECRET=change-me
# Token your own app sends in the X-Admin-Token header. Generate with: openssl rand -hex 24
ADMIN_TOKEN=change-me-too

# ---- Polling fallback (leave all four empty to disable it) --------------------------
# From your app on the Daraja portal (developer.safaricom.co.ke)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# ---- Optional ----------------------------------------------------------------------
# Docker Compose only: the public domain Caddy should get an HTTPS certificate for
DOMAIN=pay.example.com
# PORT=8080
# BIND_ADDR=0.0.0.0          # use 127.0.0.1 when a reverse proxy runs on the same host
# DB_PATH=mpesa.db
# POLL_BASE_SECS=30          # first poll after this many seconds, then doubles each time
# POLL_MAX=6                 # polls before an order becomes 'needs_review'
# POLL_TICK=10               # how often the poller wakes up
